{
  "font_family": "Times-Roman",
  "font_size": 10,
  "line_height": 1.3,
  "margin": 0.8,
  "page_size": "A4",
  "layout": {
    "type": "two-column",
    "columns": {
      "left_width": 68,
      "right_width": 32,
      "gap": 18
    }
  },
  "colors": {
    "heading": "#2c3e50",
    "text": "#000000",
    "link": "#3498db"
  },
  "background": {
    "type": "gradient",
    "color": "#ffffff",
    "gradient": {
      "start_color": "#ffffff",
      "end_color": "#f8f9fa",
      "fade_percentage": 20,
      "direction": "vertical"
    },
    "images": {
      "top": "tests/images/header_bg.png",
      "bottom": "tests/images/footer_bg.png",
      "opacity": 0.08
    }
  },
  "spacing": {
    "paragraph": 5,
    "heading": 10,
    "section": 16
  }
}