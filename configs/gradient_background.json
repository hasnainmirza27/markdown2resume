{
  "font_family": "Helvetica",
  "font_size": 11,
  "line_height": 1.2,
  "margin": 1.0,
  "page_size": "A4",
  "layout": {
    "type": "single",
    "columns": {
      "left_width": 100,
      "right_width": 0,
      "gap": 0
    }
  },
  "colors": {
    "heading": "#2c3e50",
    "text": "#000000",
    "link": "#3498db"
  },
  "background": {
    "type": "gradient",
    "color": "#ffffff",
    "gradient": {
      "start_color": "#f8f9fa",
      "end_color": "#e9ecef",
      "fade_percentage": 30,
      "direction": "vertical"
    },
    "images": {
      "top": null,
      "bottom": null,
      "opacity": 0.1
    }
  },
  "spacing": {
    "paragraph": 6,
    "heading": 12,
    "section": 18
  }
}